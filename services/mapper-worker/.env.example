# DOM Mapper worker — copy to .env.local and fill in. Nothing here has a
# baked-in default; the worker refuses to start if any required var is
# missing (see src/env.ts) rather than silently falling back to a guess.

# Same Supabase project as the main DOM app. Service-role key — this worker
# runs entirely outside the browser, on a trusted processing workstation.
# NEVER commit a real value, never expose this to any browser context.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Where NodeODM is reachable from this worker (e.g. a local Docker
# container: docker run -p 3001:3000 opendronemap/nodeodm).
NODEODM_URL=http://localhost
NODEODM_PORT=3001

# A stable identifier for this worker process — recorded on the
# mapping_processing_jobs row it claims, shown in the pilot UI, and used to
# detect which worker owned a now-stale job. Anything unique is fine, e.g.
# the workstation's hostname.
MAPPER_WORKER_ID=

# Local scratch directory for downloading imagery and NodeODM outputs
# during a job. Created if it doesn't exist; each job gets its own
# subdirectory, cleaned up after the job finishes (success or failure).
MAPPER_WORK_DIR=

# How often (ms) the worker polls Postgres for a queued job when idle.
MAPPER_POLL_INTERVAL_MS=10000

# Google Drive archive layer — all optional. Unset means the worker stays
# on the original Supabase-only upload path for raw imagery and outputs.
# Service account (not an OAuth user), so it must be shared on the target
# Drive folder / added as a member of the target Shared Drive first — see
# README.md's "Google Drive setup" section for the exact console steps.
GOOGLE_DRIVE_CLIENT_EMAIL=
# Paste the private_key field from the service account JSON key, with real
# newlines (or \n escapes — either is accepted).
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_ROOT_PARENT_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# PotreeConverter 2.x binary for the point-cloud-viewer conversion step.
# Defaults to "PotreeConverter" on PATH; set this if it's installed
# somewhere else. Missing/misconfigured means that step is skipped and
# logged — the point_cloud deliverable stays LAZ-only, not a hard failure.
POTREE_CONVERTER_PATH=PotreeConverter

# gdal_translate/gdaladdo for the orthomosaic COG tiling step. Same
# skip-and-log behavior as POTREE_CONVERTER_PATH if unset/missing — the
# original GeoTIFF still uploads and stays downloadable either way.
GDAL_TRANSLATE_PATH=gdal_translate
GDAL_ADDO_PATH=gdaladdo
