# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOM_SUBSCRIPTION_CENTS=9900

# SkyWatch insurance (stub — scaffolding only, no real partnership yet)
SKYWATCH_WEBHOOK_SECRET=

# Smartlead (inbound webhook — app/api/webhooks/smartlead/route.ts).
# HMAC signing secret from the Smartlead webhook endpoint config.
SMARTLEAD_WEBHOOK_SECRET=
# Outbound Smartlead API key (lib/smartlead.ts — campaign listing, lead
# enrollment, message history). Server-only: never expose via NEXT_PUBLIC_*.
# The whole Leads Workspace works normally without this set — outreach
# actions just show a "Smartlead not configured" state. See LEADS_WORKSPACE.md.
SMARTLEAD_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Open Mission Queue — off until enabled. See components/PilotSidebar.tsx.
NEXT_PUBLIC_MISSION_QUEUE_ENABLED=

# DOM Mapper pilot tab — off until enabled. See components/PilotSidebar.tsx
# and services/mapper-worker/README.md (the separate processing worker
# needs to actually be running against a real NodeODM instance for this to
# be useful to pilots). See MAPPER.md.
NEXT_PUBLIC_MAPPER_ENABLED=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Drone Operation Management <ops@droneopsman.com>"
# Falls back to RESEND_FROM_EMAIL if unset — only needed if you want a
# separate sender identity for lifecycle/transactional mail.
RESEND_FROM_TRANSACTIONAL=
# From the Resend webhook endpoint config (Svix signing secret, "whsec_...").
RESEND_WEBHOOK_SECRET=
NOTIFY_EMAIL=ops@droneopsman.com

# Optional: enables curl-based testing of /api/dev/test-email without an
# admin session. Leave unset to require real admin auth instead.
DEV_TEST_EMAIL_SECRET=

# Cron (app/api/cron/*) — Vercel automatically sends this as a Bearer token
# on scheduled requests when set. Any random secret works.
CRON_SECRET=

# Notion CRM
NOTION_API_KEY=
NOTION_MISSIONS_DB_ID=
NOTION_LEADS_DB_ID=

# Admin auth (replace with Supabase Auth in production)
ADMIN_EMAIL=admin@droneopsman.com
ADMIN_PASSWORD=
