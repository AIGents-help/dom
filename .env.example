# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOM_SUBSCRIPTION_CENTS=9900

# SkyWatch insurance (stub — scaffolding only, no real partnership yet)
SKYWATCH_WEBHOOK_SECRET=

# Smartlead (inbound webhook — app/api/webhooks/smartlead/route.ts).
# HMAC signing secret from the Smartlead webhook endpoint config.
SMARTLEAD_WEBHOOK_SECRET=
# Outbound Smartlead API key (lib/smartlead.ts — campaign listing, lead
# enrollment, message history). Server-only: never expose via NEXT_PUBLIC_*.
# The whole Leads Workspace works normally without this set — outreach
# actions just show a "Smartlead not configured" state. See LEADS_WORKSPACE.md.
SMARTLEAD_API_KEY=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Open Mission Queue — off until enabled. See components/PilotSidebar.tsx.
NEXT_PUBLIC_MISSION_QUEUE_ENABLED=

# DOM Mapper pilot tab — off until enabled. See components/PilotSidebar.tsx
# and services/mapper-worker/README.md (the separate processing worker
# needs to actually be running against a real NodeODM instance for this to
# be useful to pilots). See MAPPER.md.
NEXT_PUBLIC_MAPPER_ENABLED=

# Pilot Asset Inventory tab (issue #15) — off until enabled. See
# components/PilotSidebar.tsx / components/PilotAssetsTab.tsx.
NEXT_PUBLIC_PILOT_ASSETS_ENABLED=

# Resend (email)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Drone Operation Management <ops@droneopsman.com>"
# Falls back to RESEND_FROM_EMAIL if unset — only needed if you want a
# separate sender identity for lifecycle/transactional mail.
RESEND_FROM_TRANSACTIONAL=
# From the Resend webhook endpoint config (Svix signing secret, "whsec_...").
RESEND_WEBHOOK_SECRET=
NOTIFY_EMAIL=ops@droneopsman.com

# Optional: enables curl-based testing of /api/dev/test-email without an
# admin session. Leave unset to require real admin auth instead.
DEV_TEST_EMAIL_SECRET=

# Cron (app/api/cron/*) — Vercel automatically sends this as a Bearer token
# on scheduled requests when set. Any random secret works.
CRON_SECRET=

# Notion CRM
NOTION_API_KEY=
NOTION_MISSIONS_DB_ID=
NOTION_LEADS_DB_ID=

# Admin auth (replace with Supabase Auth in production)
ADMIN_EMAIL=admin@droneopsman.com
ADMIN_PASSWORD=

# DOM Mapper — Google Drive archive layer (raw imagery, orthomosaic
# masters, point cloud master LAZ, 3D models, DSM/DTM, reports). Optional:
# unset means every mapper deliverable stays on Supabase Storage exactly as
# before this feature.
#
# Required mode: OAuth 2.0 on behalf of the DOM owner's own Google account
# (a personal Google One account, not Workspace) — files are created as
# that human user and consume their storage, since a bare service account
# has no Drive quota of its own. Get GOOGLE_DRIVE_CLIENT_ID/
# GOOGLE_DRIVE_CLIENT_SECRET from a "Desktop app" OAuth client in Google
# Cloud Console, then run `npm run authorize:drive` inside
# services/mapper-worker once to mint GOOGLE_DRIVE_REFRESH_TOKEN — see
# services/mapper-worker/README.md's "Google Drive setup" for the exact
# steps. This app (not just the worker) also needs these three set,
# server-side only — never expose them via NEXT_PUBLIC_*.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Folder id the authorized account can create folders under —
# "DOM Drone Operations" is created/reused directly inside this. "root"
# means the top of that account's own My Drive.
GOOGLE_DRIVE_ROOT_PARENT_ID=

# Optional future enterprise alternative to the OAuth vars above: a
# Workspace service account + Shared Drive, used only if the OAuth vars
# are unset. See the README section for when this applies.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Signs the short-lived query-string token the Drive download proxy uses
# (app/api/pilot/mapping/.../download/file) — falls back to
# SUPABASE_SERVICE_ROLE_KEY if unset, so this is optional in practice.
MAPPER_DOWNLOAD_TOKEN_SECRET=
